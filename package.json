{
  "name": "powerbuilder-intellisense",
  "displayName": "PowerBuilder IntelliSense",
  "description": "Language support for Appeon PowerBuilder 2022/2025: completion, hover, signature help, diagnostics, and navigation from the official PowerScript reference.",
  "version": "0.3.2",
  "publisher": "jimmykirk",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimmykirk/powerbuilder-intellisense.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "powerbuilder",
    "powerscript",
    "appeon",
    "datawindow",
    "pbl"
  ],
  "activationEvents": [
    "onLanguage:powerbuilder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "powerbuilder",
        "aliases": [
          "PowerBuilder",
          "powerbuilder"
        ],
        "extensions": [
          ".sra",
          ".srw",
          ".sru",
          ".srm",
          ".srd",
          ".srf",
          ".srs",
          ".srp",
          ".srq",
          ".srj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "powerbuilder",
        "scopeName": "source.powerbuilder",
        "path": "./syntaxes/powerbuilder.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "powerbuilder",
        "path": "./snippets/powerbuilder.json"
      }
    ],
    "commands": [
      {
        "command": "powerbuilder.switchVersion",
        "title": "PowerBuilder: Switch Version (2022 ↔ 2025)"
      },
      {
        "command": "powerbuilder.generateOrcaScript",
        "title": "PowerBuilder: Generate OrcaScript to Rebuild PBLs from Source"
      }
    ],
    "configuration": {
      "title": "PowerBuilder",
      "properties": {
        "powerbuilder.version": {
          "type": "string",
          "default": "2025",
          "enum": [
            "2022",
            "2025"
          ],
          "description": "Target PowerBuilder version for language features and function catalog"
        },
        "powerbuilder.ansiEncoding": {
          "type": "string",
          "default": "windows-1252",
          "description": "Codepage for exports that are neither UTF-16 nor UTF-8 (e.g. windows-1253 for Greek). Cannot be detected from the file itself."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.js",
    "build": "npm run compile && npm run bundle",
    "watch": "tsc -watch -p ./",
    "lint": "eslint . --ext .ts",
    "test": "npm run compile && npm run bundle && node tools/lsp-smoke.js",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.6.3"
  }
}
